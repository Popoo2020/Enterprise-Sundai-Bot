{
  "name": "sundai01",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  "keep_vars": true,
  "vars": {
    "CONTACT_TO_EMAIL": "eririmo@protonmail.com",
    "CONTACT_FROM_EMAIL": "SundAI Website <website@sundaibot.com>",
    "TURNSTILE_ALLOWED_HOSTNAMES": "sundaibot.com,www.sundaibot.com"
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
