<div class="pc-sections"><section class="pc-products"><div class="pc-wrap"><header class="pc-section-top"><h2><span  data-he="מה תקבלו בסוף" data-en="What you learn." data-sv="Det ni lär er." data-da="Det I lærer.">מה תקבלו בסוף</span><br><span class="pc-badge"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg></span><span  data-he="הסדנה או הפרויקט?" data-en="What you build." data-sv="Det ni bygger." data-da="Det I bygger.">הסדנה או הפרויקט?</span></h2></header><div class="pc-deck"><article class="pc-chapter pc-chapter-1"><figure class="pc-stage pc-stage-school"><img loading="lazy" decoding="async" src="__PHOTO_SCHOOL__" class="pc-stage-photo" alt="" width="1248" height="832"><div class="pc-scrim"></div><span class="pc-poster-label"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="Teen Tech AI" data-en="Teen Tech AI" data-sv="Teen Tech AI" data-da="Teen Tech AI">Teen Tech AI</span></span><div class="pc-receipt"><div class="pc-receipt-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v13H3zM8 21h8M10 18v3m4-3v3M6 8h2m2 0h2M7 14l3-3 3 2 3-3 2 2"/></svg><strong  data-he="בדיקת מבצע" data-en="Deal check" data-sv="Prisjämförelse" data-da="Pristjek">בדיקת מבצע</strong></div><div class="pc-receipt-row"><span  data-he="מחיר" data-en="Item price" data-sv="Varans pris" data-da="Varens pris">מחיר</span><b dir="ltr">€19.90</b></div><div class="pc-receipt-row"><span  data-he="משלוח" data-en="Delivery" data-sv="Frakt" data-da="Levering">משלוח</span><b dir="ltr">€6.10</b></div><div class="pc-receipt-total"><span  data-he="סך הכול" data-en="Total" data-sv="Totalt" data-da="I alt">סך הכול</span><b dir="ltr">€26.00</b></div></div></figure><div class="pc-chapter-copy"><div class="pc-chapter-meta"><span class="pc-cat"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="חינוך · כיתות ח׳–ט׳" data-en="Schools · Grades 8–9" data-sv="Skola · åk 8–9" data-da="Skoler · 8.–9. klasse">חינוך · כיתות ח׳–ט׳</span></span><span class="pc-count" dir="ltr">01 <i>/ 03</i></span></div><h3  data-he="אתר שהתלמידים בונים ובודקים בעצמם" data-en="From a claim to a working website." data-sv="Från ett påstående till en egen webbplats." data-da="Fra en påstand til en færdig hjemmeside.">אתר שהתלמידים בונים ובודקים בעצמם</h3><p  data-he="התלמידים בודקים טענה שמופיעה בסרטון ובונים אתר להשוואת מחירים, כולל משלוח. זוג אחר בכיתה מנסה אותו, והיוצרים משפרים את האתר לפי המשוב." data-en="Pupils investigate a claim, compare offers and build a tool another pupil can actually use." data-sv="Eleverna granskar ett påstående, jämför erbjudanden och bygger ett verktyg som en annan elev kan använda." data-da="Eleverne undersøger en påstand, sammenligner tilbud og bygger et værktøj, som en anden elev kan bruge.">התלמידים בודקים טענה שמופיעה בסרטון ובונים אתר להשוואת מחירים, כולל משלוח. זוג אחר בכיתה מנסה אותו, והיוצרים משפרים את האתר לפי המשוב.</p><a class="pc-button pc-outline" href="__COURSE_YOUTH_URL__"><span data-he="לפרטי הקורס" data-en="Explore the course" data-sv="Se utbildningen" data-da="Se kurset">לפרטי הקורס</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></article><article class="pc-chapter pc-chapter-2"><figure class="pc-stage pc-stage-studio" aria-hidden="true"><span class="pc-poster-label"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="ערכת ההוראה" data-en="Lesson kit" data-sv="Lektionsmaterial" data-da="Lektionsmateriale">ערכת ההוראה</span></span><div class="pc-paper-stack"><div class="pc-paper pc-back-sheet"></div><div class="pc-paper pc-main-sheet"><div class="pc-sheet-top"><span></span><i></i><i></i><i></i></div><strong  data-he="כרטיס יציאה" data-en="Exit ticket" data-sv="Exit ticket" data-da="Exit-ticket">כרטיס יציאה</strong><svg class="pc-water" viewBox="0 0 210 104" aria-hidden="true" fill="none"><path d="M25 79c18-3 25-8 43-4 12 2 19 6 31 6s22-5 32-5c18 0 27 7 43 4" stroke="#173626" stroke-width="3" stroke-linecap="round"/><path d="M78 65c-8-16 13-16 5-32m22 29c-7-15 14-20 8-35m17 33c-6-13 11-16 7-28" stroke="#296942" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 5"/><circle cx="165" cy="25" r="14" fill="#c3ed8c" stroke="#285c32" stroke-width="2"/><path d="M165 3v6m0 32v6m22-22h-6m-36 0h-6m12-15 5 4m18 23 4 4m-2-30-4 4" stroke="#285c32" stroke-width="2" stroke-linecap="round"/></svg><div class="pc-sheet-rules"><i></i><i></i></div><div class="pc-sheet-check">✓</div></div></div></figure><div class="pc-chapter-copy"><div class="pc-chapter-meta"><span class="pc-cat"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="חינוך · צוותי הוראה" data-en="Schools · Teachers" data-sv="Skola · lärare" data-da="Skoler · lærere">חינוך · צוותי הוראה</span></span><span class="pc-count" dir="ltr">02 <i>/ 03</i></span></div><h3  data-he="מערך שיעור מוכן לשבוע הבא" data-en="A lesson ready for next week." data-sv="En färdig lektion för nästa vecka." data-da="En lektion klar til næste uge.">מערך שיעור מוכן לשבוע הבא</h3><p  data-he="המורים בוחרים נושא שילמדו בקרוב ומכינים שתי פעילויות לאותה מטרת למידה. אחרי השיעור בודקים מה התלמידים הבינו ומשפרים את הפעילות." data-en="Design two activities for one objective, verify the content and refine the kit using your pupils’ answers." data-sv="Skapa två aktiviteter för samma mål, kontrollera innehållet och förbättra materialet utifrån elevernas svar." data-da="Lav to aktiviteter til det samme mål, tjek indholdet og tilpas materialet ud fra elevernes svar.">המורים בוחרים נושא שילמדו בקרוב ומכינים שתי פעילויות לאותה מטרת למידה. אחרי השיעור בודקים מה התלמידים הבינו ומשפרים את הפעילות.</p><a class="pc-button pc-outline" href="__COURSE_TEACHERS_URL__"><span data-he="לפרטי הקורס" data-en="Explore the course" data-sv="Se utbildningen" data-da="Se kurset">לפרטי הקורס</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></article><article class="pc-chapter pc-chapter-3"><figure class="pc-stage pc-stage-team"><img loading="lazy" decoding="async" src="__PHOTO_TEAM__" class="pc-stage-photo" alt="" width="1248" height="832"><div class="pc-scrim"></div><span class="pc-poster-label"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="AI Governance" data-en="AI Governance" data-sv="AI-styrning" data-da="AI-governance">AI Governance</span></span><div class="pc-audit"><div class="pc-receipt-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3.5 5.8v6.1c0 5.2 3.6 8.4 8.5 10.1 4.9-1.7 8.5-4.9 8.5-10.1V5.8L12 2Zm-4 10 2.7 2.7 5.7-6"/></svg><strong  data-he="רשומת החלטה" data-en="Decision record" data-sv="Beslutsunderlag" data-da="Beslutningsgrundlag">רשומת החלטה</strong></div><div class="pc-audit-line"><i></i><span  data-he="נבדקו הרשאות" data-en="Access checked" data-sv="Behörighet kontrollerad" data-da="Adgang kontrolleret">נבדקו הרשאות</span></div><div class="pc-audit-line"><i></i><span  data-he="נמצא מקור מאושר" data-en="Approved source found" data-sv="Godkänd källa hittad" data-da="Godkendt kilde fundet">נמצא מקור מאושר</span></div><div class="pc-audit-line"><i></i><span  data-he="נדרש אישור אנושי" data-en="Human review required" data-sv="Manuell granskning krävs" data-da="Manuel gennemgang kræves">נדרש אישור אנושי</span></div></div></figure><div class="pc-chapter-copy"><div class="pc-chapter-meta"><span class="pc-cat"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 0c1.8 10.5 5.5 14.2 16 16-10.5 1.8-14.2 5.5-16 16C14.2 21.5 10.5 17.8 0 16 10.5 14.2 14.2 10.5 16 0Z"/></svg><span  data-he="ארגונים · ממשל ואבטחת AI" data-en="Organisations · AI governance" data-sv="Organisationer · AI-styrning" data-da="Organisationer · AI-governance">ארגונים · ממשל ואבטחת AI</span></span><span class="pc-count" dir="ltr">03 <i>/ 03</i></span></div><h3  data-he="כללים ברורים לאישור פעולות של AI" data-en="Who owns the decision?" data-sv="Vem ansvarar för beslutet?" data-da="Hvem tager ansvaret for beslutningen?">כללים ברורים לאישור פעולות של AI</h3><p  data-he="מסכמים בכתב לאילו מסמכים העוזר רשאי לגשת ומה הוא יכול לעשות. למשל, העוזר יכול להכין תשובה ללקוח, ואיש צוות מאשר אותה לפני השליחה." data-en="Define who can see the source, what the assistant may do and which decisions need human review." data-sv="Bestäm vem som får se källan, vad assistenten får göra och vilka beslut en människa måste granska." data-da="Afgør, hvem der må se kilden, hvad assistenten må gøre, og hvilke beslutninger et menneske skal gennemgå.">מסכמים בכתב לאילו מסמכים העוזר רשאי לגשת ומה הוא יכול לעשות. למשל, העוזר יכול להכין תשובה ללקוח, ואיש צוות מאשר אותה לפני השליחה.</p><a class="pc-button pc-outline" href="__SERVICE_COMPLIANCE_AI_GOVERNANCE_URL__"><span  data-he="לשירותי ממשל AI" data-en="Explore AI governance" data-sv="Utforska AI-styrning" data-da="Se AI-governance">לשירותי ממשל AI</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></article></div>
<aside class="pc-banner"><div><h2  data-he="איזו משימה חוזרת גוזלת לצוות זמן?" data-en="Which recurring task takes up your team’s time?" data-sv="Vilken uppgift tar tid från ert team?" data-da="Hvilken opgave tager tid fra jeres team?">איזו משימה חוזרת גוזלת לצוות זמן?</h2></div><div><p  data-he="בחרו משימה ובדקו אילו שלבים אפשר לקצר ואיפה חשוב להשאיר את ההחלטה בידי הצוות." data-en="Pick one workflow. See where AI can help and where a human should approve." data-sv="Välj ett arbetsflöde. Se var AI kan hjälpa och när en människa ska godkänna." data-da="Vælg én arbejdsgang. Se, hvor AI kan hjælpe, og hvor et menneske skal godkende.">בחרו משימה ובדקו אילו שלבים אפשר לקצר ואיפה חשוב להשאיר את ההחלטה בידי הצוות.</p><a class="pc-button pc-white-btn" href="__WORKFLOW_PLANNER_URL__" hreflang="__RESOURCE_LANG__"><span  data-he="לכלי לתכנון התהליך (באנגלית)" data-en="Open workflow planner" data-sv="Planera arbetsflödet" data-da="Planlæg arbejdsgangen">לכלי לתכנון התהליך (באנגלית)</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></aside></div></section>

<section class="pc-courses" id="courses"><div class="pc-wrap pc-course-layout"><header><h2  data-he="איזה קורס מתאים לכם?" data-en="Training programmes." data-sv="Utbildningar." data-da="Undervisningsforløb.">איזה קורס מתאים לכם?</h2><p  data-he="בכל עמוד קורס תמצאו את תוכנית הלימודים, את מבנה המפגשים ודוגמה למה שתוכלו להכין בעצמכם." data-en="Choose a programme to see its outcome, timing and syllabus." data-sv="Välj en utbildning för att se resultat, omfattning och kursplan." data-da="Vælg et forløb for at se udbytte, varighed og kursusplan.">בכל עמוד קורס תמצאו את תוכנית הלימודים, את מבנה המפגשים ודוגמה למה שתוכלו להכין בעצמכם.</p><p class="biz-language">__TEACHING_LANGUAGES__</p></header><div class="pc-course-list">__BEGINNER_COURSE_ROW__<details class="pc-course" open><summary><span><small  data-he="כיתות ח׳–ט׳ · עד 24 תלמידים" data-en="Grades 8–9 · up to 24 pupils" data-sv="Åk 8–9 · upp till 24 elever" data-da="8.–9. klasse · op til 24 elever">כיתות ח׳–ט׳ · עד 24 תלמידים</small><strong  data-he="הייתם משתפים את זה?" data-en="Would you share it?" data-sv="Skulle du dela det här?" data-da="Ville du dele det?">הייתם משתפים את זה?</strong></span><i aria-hidden="true"></i></summary><div class="pc-course-body"><b  data-he="4 מפגשים בני 90 דקות" data-en="Four 90-minute sessions" data-sv="Fyra träffar à 90 minuter" data-da="Fire gange 90 minutter">4 מפגשים בני 90 דקות</b><p  data-he="בודקים מי פרסם סרטון, מזהים ניסיונות דיוג ובונים אתר בזוגות. אחר כך זוג אחר מנסה את האתר ומספר מה היה ברור ומה כדאי לשפר." data-en="Investigate videos, spot phishing and build a working website. Each pair tests with another user." data-sv="Granska videor, upptäck nätfiske och bygg en fungerande webbplats som en annan elev testar." data-da="Undersøg videoer, genkend phishing og byg en hjemmeside, som en anden elev tester.">בודקים מי פרסם סרטון, מזהים ניסיונות דיוג ובונים אתר בזוגות. אחר כך זוג אחר מנסה את האתר ומספר מה היה ברור ומה כדאי לשפר.</p><a class="pc-course-link" href="__COURSE_YOUTH_URL__"><span data-he="לעמוד הקורס" data-en="Course details" data-sv="Om utbildningen" data-da="Om kurset">לעמוד הקורס</span></a><a class="pc-doc-btn" href="__PDF_YOUTH__" download><span  data-he="סילבוס בעברית" data-en="English syllabus" data-sv="Kursplan på svenska" data-da="Kursusplan på dansk">סילבוס בעברית</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3v12m-5-5 5 5 5-5M4 16v3h16v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></details><details class="pc-course" ><summary><span><small  data-he="צוותי הוראה · עד 12 מורים" data-en="Teaching teams · up to 12 teachers" data-sv="Lärarlag · upp till 12 lärare" data-da="Lærerteams · op til 12 lærere">צוותי הוראה · עד 12 מורים</small><strong  data-he="השיעור של השבוע הבא" data-en="Next week’s lesson" data-sv="Nästa veckas lektion" data-da="Næste uges lektion">השיעור של השבוע הבא</strong></span><i aria-hidden="true"></i></summary><div class="pc-course-body"><b  data-he="שני מפגשים בני 90 דקות ועוד 30 דקות עצמאיות" data-en="Two 90-minute sessions and 30 minutes of independent work" data-sv="Två träffar à 90 minuter och 30 minuter eget arbete" data-da="To gange 90 minutter og 30 minutters selvstændigt arbejde">שני מפגשים בני 90 דקות ועוד 30 דקות עצמאיות</b><p  data-he="מכינים שתי פעילויות לאותה מטרת למידה, מנסים אחת בכיתה ומשתמשים בתשובות התלמידים כדי לשפר את מערך השיעור." data-en="Try two routes to one objective, check what pupils understood and hand a colleague a lesson kit." data-sv="Pröva två vägar till samma mål, undersök vad eleverna förstått och lämna materialet till en kollega." data-da="Afprøv to veje til samme mål, undersøg hvad eleverne har forstået, og giv materialet til en kollega.">מכינים שתי פעילויות לאותה מטרת למידה, מנסים אחת בכיתה ומשתמשים בתשובות התלמידים כדי לשפר את מערך השיעור.</p><a class="pc-course-link" href="__COURSE_TEACHERS_URL__"><span data-he="לעמוד הקורס" data-en="Course details" data-sv="Om utbildningen" data-da="Om kurset">לעמוד הקורס</span></a><a class="pc-doc-btn" href="__PDF_TEACHER__" download><span  data-he="סילבוס בעברית" data-en="English syllabus" data-sv="Kursplan på svenska" data-da="Kursusplan på dansk">סילבוס בעברית</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3v12m-5-5 5 5 5-5M4 16v3h16v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></details><details class="pc-course" ><summary><span><small  data-he="בתי חולים · 6–10 מדריכים" data-en="Hospitals · 6–10 trainers" data-sv="Sjukhus · 6–10 handledare" data-da="Hospitaler · 6–10 undervisere">בתי חולים · 6–10 מדריכים</small><strong  data-he="המשמרת הראשונה" data-en="The first shift" data-sv="Första arbetspasset" data-da="Den første vagt">המשמרת הראשונה</strong></span><i aria-hidden="true"></i></summary><div class="pc-course-body"><b  data-he="שני מפגשים בני שעתיים ושעה עצמאית" data-en="Two 2-hour sessions and one hour of independent work" data-sv="Två träffar à två timmar och en timme eget arbete" data-da="To gange to timer og en times selvstændigt arbejde">שני מפגשים בני שעתיים ושעה עצמאית</b><p  data-he="מתכננים משחק תפקידים סביב שיחה בדלפק הקבלה. בוחרים שני רגעים שבהם העובד צריך להחליט איך להגיב, ונותנים לעמית לנסות את התרגיל עם ההנחיות שהכנתם." data-en="Build a simulated service conversation with two decisions. A colleague runs the scenario with your kit." data-sv="Bygg en samtalsövning med två beslut. En kollega genomför scenariot med ditt material." data-da="Byg en samtaleøvelse med to valg. En kollega afprøver scenariet med dit materiale.">מתכננים משחק תפקידים סביב שיחה בדלפק הקבלה. בוחרים שני רגעים שבהם העובד צריך להחליט איך להגיב, ונותנים לעמית לנסות את התרגיל עם ההנחיות שהכנתם.</p><a class="pc-course-link" href="__COURSE_HOSPITAL_URL__"><span data-he="לעמוד הקורס" data-en="Course details" data-sv="Om utbildningen" data-da="Om kurset">לעמוד הקורס</span></a><a class="pc-doc-btn" href="__PDF_HOSPITAL__" download><span  data-he="סילבוס בעברית" data-en="English syllabus" data-sv="Kursplan på svenska" data-da="Kursusplan på dansk">סילבוס בעברית</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3v12m-5-5 5 5 5-5M4 16v3h16v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></details><details class="pc-course" ><summary><span><small  data-he="רשויות וממשל · עד 10 משתתפים" data-en="Public authorities · up to 10 participants" data-sv="Offentlig sektor · upp till 10 deltagare" data-da="Offentlige myndigheder · op til 10 deltagere">רשויות וממשל · עד 10 משתתפים</small><strong  data-he="מי נשאר מחוץ לסיכום?" data-en="Whose voice is missing?" data-sv="Vems röst saknas?" data-da="Hvis stemme mangler?">מי נשאר מחוץ לסיכום?</strong></span><i aria-hidden="true"></i></summary><div class="pc-course-body"><b  data-he="שני מפגשים בני 90 דקות" data-en="Two 90-minute sessions" data-sv="Två träffar à 90 minuter" data-da="To gange 90 minutter">שני מפגשים בני 90 דקות</b><p  data-he="מסכמים 30 תגובות של תושבים בתרגיל מדומה ובודקים כל ציטוט מול המקור. מי שקורא את הסיכום יוכל לראות גם הסתייגות שהעלה תושב אחד." data-en="Turn 30 fictional responses into a one-page brief, check sources and recover an omitted minority view." data-sv="Sammanfatta 30 fiktiva svar på en sida, granska källorna och återge ett utelämnat minoritetsperspektiv." data-da="Sammenfat 30 fiktive svar på én side, tjek kilderne og få et overset mindretalsperspektiv med.">מסכמים 30 תגובות של תושבים בתרגיל מדומה ובודקים כל ציטוט מול המקור. מי שקורא את הסיכום יוכל לראות גם הסתייגות שהעלה תושב אחד.</p><a class="pc-course-link" href="__COURSE_PUBLIC_URL__"><span data-he="לעמוד הקורס" data-en="Course details" data-sv="Om utbildningen" data-da="Om kurset">לעמוד הקורס</span></a><a class="pc-doc-btn" href="__PDF_PUBLIC__" download><span  data-he="סילבוס בעברית" data-en="English syllabus" data-sv="Kursplan på svenska" data-da="Kursusplan på dansk">סילבוס בעברית</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3v12m-5-5 5 5 5-5M4 16v3h16v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></details></div></div>__TRAINING_PARTNERS__</section>
<section class="pc-proof" id="evidence"><div class="pc-wrap"><article class="pc-proof-card"><div class="pc-proof-copy"><small  data-he="מתוך עסקו של המייסד" data-en="From the founder’s business" data-sv="Från grundarens verksamhet" data-da="Fra stifterens virksomhed">מתוך עסקו של המייסד</small><h2  data-he="איך מנהלים משמרת ב־Ariel’s Pizza?" data-en="Behind a shift at Ariel’s Pizza." data-sv="Bakom ett arbetspass på Ariel’s Pizza." data-da="Bag en vagt hos Ariel’s Pizza.">איך מנהלים משמרת ב־Ariel’s Pizza?</h2><p  data-he="במסעדה באודנסה חיברנו בין סידור העבודה, משימות המטבח וההנחיות לעובדים. הצוות יכול לבדוק מי במשמרת ומה צריך לעשות." data-en="In Odense, shift planning, daily tasks and staff guidance became connected tools for the team." data-sv="I Odense byggdes verktyg för schemaläggning, dagliga uppgifter och instruktioner till personalen." data-da="I Odense blev der bygget værktøjer til vagtplaner, daglige opgaver og vejledning af medarbejderne.">במסעדה באודנסה חיברנו בין סידור העבודה, משימות המטבח וההנחיות לעובדים. הצוות יכול לבדוק מי במשמרת ומה צריך לעשות.</p><a class="pc-button pc-dark-btn" href="__CASE_STUDY_URL__" hreflang="__RESOURCE_LANG__"><span  data-he="לסיפור המלא של הפרויקט (באנגלית)" data-en="Read the case study" data-sv="Läs om projektet" data-da="Læs om projektet">לסיפור המלא של הפרויקט (באנגלית)</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><div class="pc-proof-art" aria-hidden="true"><div class="pc-board-frame"><div class="pc-board-top"><b>Ariel’s Pizza</b><i></i><i></i><i></i></div><div class="pc-board-live"><i></i><span  data-he="לוח משמרת לדוגמה" data-en="Illustrative shift board" data-sv="Exempel på arbetspass" data-da="Eksempel på vagtplan">לוח משמרת לדוגמה</span></div><div class="pc-board-line"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18v13H3zM8 21h8M10 18v3m4-3v3M6 8h2m2 0h2M7 14l3-3 3 2 3-3 2 2"/></svg></span><span  data-he="תכנון משמרות" data-en="Shift planning" data-sv="Schemaläggning" data-da="Vagtplan">תכנון משמרות</span><i></i></div><div class="pc-board-line"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h6v6H3zM15 15h6v6h-6zM10 6h5a3 3 0 0 1 3 3v4m-3-3 3 3 3-3M14 18H9a3 3 0 0 1-3-3v-4"/></svg></span><span  data-he="משימות המטבח" data-en="Kitchen tasks" data-sv="Köksuppgifter" data-da="Køkkenopgaver">משימות המטבח</span><i></i></div><div class="pc-board-line"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h14a2 2 0 0 1 2 2v8H9l-6 4V4Zm5 4h6m-6 3h4m1 7h4l4 3V9"/></svg></span><span  data-he="הנחיות לצוות" data-en="Staff guidance" data-sv="Personalstöd" data-da="Vejledning til teamet">הנחיות לצוות</span><i></i></div></div></div></article></div></section></div>