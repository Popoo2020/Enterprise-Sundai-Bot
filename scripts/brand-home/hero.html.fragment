<div id="sd-hero-art" class="sd-art" data-scene="0">
  <div class="sd-dots" aria-hidden="true"></div>
  <svg class="sd-art-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0" focusable="false">
    <defs>
      <symbol id="sd-doc-icon" viewBox="0 0 24 24"><path d="M6.8 3.4h7.6l4 4v13.2H6.8z M14.2 3.8v4.1h4.1 M9.5 11.2h6.5m-6.5 3h6.5m-6.5 3h4.3" stroke="currentColor" stroke-width="1.45" fill="none" stroke-linejoin="round" stroke-linecap="round"/></symbol>
    </defs>
  </svg>
  <div class="sd-demo-frame" id="sd-demo-school" data-demo="0" data-view="crop" role="group">
    <div class="sd-frame-inner">
      <div class="sd-picture-stage">
        <div class="sd-photo" id="sd-school-photo">
          <img src="/assets/brand-home/balloon-source.webp" data-sv-text="En röd och gräddvit luftballong i närbild." data-da-text="Et nærbillede af en rød og cremefarvet luftballon." data-he-key="altCrop" data-he-text="תקריב של כדור פורח בצבעי אדום ושמנת." alt="A close-up of a red and cream hot-air balloon." decoding="async">
        </div>
        <span class="sd-character sd-sunny" aria-hidden="true" data-motion="/brand/crew/v2/sunny-motion.webp">
          <img src="/brand/crew/v2/sunny.webp" alt="" decoding="async" width="350" height="414">
        </span>
        <span class="sd-character sd-dan" aria-hidden="true" data-motion="/brand/crew/v2/dan-motion.webp" hidden>
          <img data-poster="/brand/crew/v2/dan.webp" alt="" decoding="async" width="240" height="342">
        </span>
      </div>
      <div class="sd-frame-caption">
        <div class="sd-widget-head"><strong data-sd-word="schoolTitle" data-sv-text="Utanför bild" data-da-text="Uden for billedet" data-he-key="schoolTitle" data-he-text="מה נשאר מחוץ לתמונה?">Outside the frame</strong></div>
        <div class="sd-note-box">
          <span class="sd-note-reserve" aria-hidden="true"></span>
          <p class="sd-photo-note" aria-live="polite" data-sd-frame-note data-sv-text="Är luftballongen ensam på himlen?" data-da-text="Er luftballonen alene på himlen?" data-he-key="question" data-he-text="האם זה הכדור הפורח היחיד בשמיים?">Is this balloon alone in the sky?</p>
        </div>
        <button type="button" class="sd-result-btn" data-reveal-frame aria-controls="sd-school-photo" aria-expanded="false"><span data-sd-frame-action data-sv-text="Visa hela bilden" data-da-text="Vis hele billedet" data-he-key="reveal" data-he-text="לתמונה המלאה">Show the full photo</span><svg class="sd-photo-arrow" aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3.5 12.5 12.5 3.5m-6 0h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <noscript><a class="sd-photo-link" href="/assets/brand-home/balloon-source.webp">__FULL_PHOTO__ <svg class="sd-photo-arrow" aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3.5 12.5 12.5 3.5m-6 0h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></noscript>
      </div>
    </div>
  </div>
  <div class="sd-chip-scene" id="sd-demo-governance" data-demo="1" role="group" hidden>
    <div class="sd-socket"><div class="sd-socket-grid"></div><i class="sd-rail sd-r1"></i><i class="sd-rail sd-r2"></i><i class="sd-rail sd-r3"></i><i class="sd-rail sd-r4"></i><div class="sd-chip"><span class="sd-chip-label">GRC</span><span class="sd-chip-pins" aria-hidden="true">•••</span><strong dir="ltr">SundAI</strong><small dir="ltr">AI · 42001<br>REV 02 / EU</small></div></div>
    <button type="button" class="sd-chip-action" data-governance><span class="sd-tiny-led" aria-hidden="true"></span><span data-sd-gov-msg data-he-key="review" data-he-text="לבדיקת ההחלטה">Review a decision</span><span aria-hidden="true">↗</span></button>
  </div>
  <div class="sd-rag-scene" id="sd-demo-assistant" data-demo="2" role="group" hidden>
    <div class="sd-rag-stack" aria-hidden="true"><div></div><div></div></div>
    <div class="sd-rag-panel">
      <div class="sd-rag-top"><b>RAG</b><i class="sd-tiny-led"></i></div>
      <strong data-sd-word="ragTitle" data-he-key="ragTitle" data-he-text="שאלה לעוזר הארגוני">Ask your knowledge</strong><p data-sd-word="ragQuestion" data-he-key="ragQuestion" data-he-text="מי מוסמך לאשר החזר כספי?">Who approves a refund?</p>
      <div class="sd-source"><svg aria-hidden="true"><use href="#sd-doc-icon"/></svg><span data-sd-word="ragSource" data-he-key="ragSource" data-he-text="נוהל החזרים · סעיף 2">Refund policy · §2</span><span aria-hidden="true">↗</span></div>
      <button type="button" data-source><span data-sd-source-msg data-he-key="inspect" data-he-text="למקור התשובה">Inspect source</span><span aria-hidden="true">↗</span></button>
    </div>
  </div>
</div>
